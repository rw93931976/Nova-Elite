# Voice worker (agent-droplet.py) — copy to .env.local on droplet or local voice dev

NOVA_LIVE_REFERENCES=1
# NOVA_LIVE_REF_DIR=/root/nova/nova-data/library/live

NOVA_STUDY_INDEX=1
NOVA_SCHEDULING=1
# NOVA_TIMEZONE=America/Chicago

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# TTS: cartesia | deepgram (Aura-1) | openai | openai_realtime
# NOVA_TTS=deepgram
# NOVA_DEEPGRAM_TTS_MODEL=aura-stella-en
# Other Aura-1 voices: aura-luna-en, aura-orion-en, aura-arcas-en (see Deepgram TTS docs)

# Health watchdog → Pushover (https://pushover.net) — add to droplet .env.local only
# PUSHOVER_TOKEN=your_app_api_token
# PUSHOVER_USER=your_user_key
# PUSHOVER_DEVICE=optional_device_name

# L7 sandbox training (My Simple AI Help + Ron's Art). Human gate stays on all sends.
# KATE_SANDBOX_MODE=1
# VITE_KATE_SANDBOX_MODE=1

# Offsite droplet backup to DO Spaces after each local backup (default on).
# NOVA_BACKUP_OFFSITE=1
